# Copy to .env.production (gitignored). Used when building for production.
#
# Deploy flow: ./infra/deploy.sh (from repo root) creates the S3 bucket + CloudFront
# and uploads the app. You only need the API URL here.

# Required — API Gateway base URL (no trailing slash)
VITE_API_BASE_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com/prod

# Optional: custom domain for CloudFront is configured via env vars when running
# infra/deploy.sh — see infra/bootstrap-domain.sh
